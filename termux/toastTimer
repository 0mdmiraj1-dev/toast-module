#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
style=normal
if [[ ${1:-} == -s || ${1:-} == --style ]]; then
  [[ $# -ge 3 ]] || { echo 'Usage: toastTimer [-s normal|bold|italic] minutes' >&2; exit 2; }
  style=${2,,}; shift 2
fi
[[ $style =~ ^(normal|bold|italic)$ ]] || { echo 'Style must be normal, bold, italic' >&2; exit 2; }
[[ $# -eq 1 && $1 =~ ^[0-9]{1,2}$ ]] || { echo 'Usage: toastTimer [-s normal|bold|italic] <minutes 1..60>' >&2; exit 2; }
minutes=$((10#$1))
((minutes >= 1 && minutes <= 60)) || { echo 'Minutes must be 1..60' >&2; exit 2; }
printf -v label 'Remaining %02d:00' "$minutes"
exec "${PREFIX}/bin/s9-toast-client" timer "$((minutes*60))" "$label" "$style" -16711936
